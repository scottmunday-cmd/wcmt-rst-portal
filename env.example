# Copy this file to .env.local for local development, and enter the same
# values (without NEXT_PUBLIC_ ones being any different) into Vercel's
# Project Settings -> Environment Variables for staging/production.
# NEVER commit a file named .env or .env.local — .gitignore already excludes them.

# --- Supabase (Project Settings -> API in the Supabase dashboard) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: full database access, bypasses RLS. Server-side only —
# never expose this to the browser, never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Developers -> API keys in the Stripe dashboard) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# From Developers -> Webhooks, after you add the endpoint (see README)
STRIPE_WEBHOOK_SECRET=

# --- ClickSend (SMS) ---
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
